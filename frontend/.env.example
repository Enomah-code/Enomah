# ============================================================
#  Angeleck — Exemple de configuration
#  Copier vers .env.local et renseigner les valeurs.
# ============================================================

# Clé API Claude (Anthropic). Reste côté serveur via la route /api/chat.
# Sans clé -> mode démo automatique (réponses simulées).
ANTHROPIC_API_KEY=sk-ant-...

# Backend FastAPI optionnel (non requis pour le chat).
NEXT_PUBLIC_API_URL=http://localhost:8000
