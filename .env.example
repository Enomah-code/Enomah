# =============================================================================
# RAPHAËL AI NETWORK — Configuration
# Copiez ce fichier en .env et remplissez vos clés API
# =============================================================================

# --- Anthropic (OBLIGATOIRE) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Modèles par rôle ---
ORCHESTRATOR_MODEL=claude-opus-4-8
SPECIALIST_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5

# --- Base de données ---
DATABASE_URL=sqlite+aiosqlite:///./raphael.db
VECTOR_DB_PATH=./raphael_vectors

# --- Redis (pour les tâches asynchrones) ---
REDIS_URL=redis://localhost:6379/0

# --- Recherche Web ---
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=

# --- Google AI Studio (Gemini) — clé sur https://aistudio.google.com/apikey ---
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_PROJECT_NAME=
GOOGLE_AI_STUDIO_PROJECT_NUMBER=
GOOGLE_AI_STUDIO_MODEL=gemini-3.6-flash

# --- Génération d'images ---
STABILITY_AI_API_KEY=
OPENAI_API_KEY=       # Pour DALL-E 3
MIDJOURNEY_API_KEY=
REPLICATE_API_KEY=    # Flux, SDXL, etc.

# --- Génération de vidéos ---
RUNWAYML_API_KEY=
HEYGEN_API_KEY=
PIKA_API_KEY=
KLING_API_KEY=

# --- Plateformes publicitaires ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
TIKTOK_APP_ID=
TIKTOK_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Réseaux sociaux ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Trading & Finance ---
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
COINBASE_API_KEY=
COINBASE_SECRET=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper trading par défaut
ALPHA_VANTAGE_API_KEY=
COINMARKETCAP_API_KEY=

# --- E-commerce ---
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_URL=
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
WOOCOMMERCE_URL=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- Services Cloud ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GCS_PROJECT_ID=
GCS_CREDENTIALS_PATH=

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=changeme-generate-a-strong-secret-here
API_DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Mémoire & Evolution ---
MEMORY_MAX_ENTRIES=10000
EVOLUTION_INTERVAL_HOURS=24
PERFORMANCE_EVAL_INTERVAL_HOURS=6
AUTO_SPAWN_AGENTS=true
MIN_TASK_SUCCESS_RATE=0.75

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/raphael.log
