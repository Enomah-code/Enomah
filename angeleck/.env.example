# =============================================================================
# Angeleck OS — Configuration (copiez en .env)
# Aucune clé d'API payante requise : tout fonctionne avec Ollama en local.
# =============================================================================

# --- Environnement ---
ENVIRONMENT=development

# --- Ollama (moteur IA local) ---
OLLAMA_BASE_URL=http://localhost:11434
SUPERVISOR_MODEL=llama3
AGENT_MODEL=mistral
FAST_MODEL=phi3
FACTORY_MODEL=qwen2.5-coder
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.7

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://angeleck:angeleck@localhost:5432/angeleck

# --- Redis (cache / mémoire court terme) ---
REDIS_URL=redis://localhost:6379/0

# --- Mémoire vectorielle (ChromaDB) ---
VECTOR_DB_PATH=./data/chroma

# --- Sécurité (CHANGEZ ce secret en production !) ---
SECRET_KEY=change-me-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# --- Limitation de ressources ---
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=25
MAX_AGENT_ITERATIONS=8

# --- Factory (recruteur automatique d'agents) ---
AUTO_SPAWN_AGENTS=true

# --- Logs ---
LOG_LEVEL=INFO
LOG_FILE=logs/angeleck.log
