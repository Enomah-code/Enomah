# ============================================================
#  Angeleck OS — variables d'environnement (exemple)
#  Copiez ce fichier en .env et adaptez les valeurs.
# ============================================================

# --- Application ---
APP_NAME=Angeleck OS
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Origines autorisées pour le frontend EMK Blue Diamond Studio.
# Mettez l'URL exacte du frontend en production (ex: https://studio.emk-blue-diamond.com)
CORS_ORIGINS=*

# --- Sécurité ---
# CHANGEZ cette clé en production : openssl rand -hex 32
SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL ---
POSTGRES_USER=angeleck
POSTGRES_PASSWORD=angeleck
POSTGRES_DB=angeleck
# En Docker : POSTGRES_HOST=postgres ; en local : localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- ChromaDB (mémoire longue) ---
# En Docker : CHROMA_HOST=chroma ; en local : localhost
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=angeleck_memory
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Ollama (modèles IA locaux) ---
# En Docker : http://ollama:11434 ; en local : http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BRAIN_MODEL=llama3.1
OLLAMA_AGENT_MODEL=mistral
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.7

# --- Chemins ---
GENERATED_AGENTS_DIR=app/agents/generated
UPLOADS_DIR=uploads

# --- Compte admin initial (créé par scripts/seed_admin.py) ---
ADMIN_EMAIL=admin@angeleck.os
ADMIN_PASSWORD=changeme123
