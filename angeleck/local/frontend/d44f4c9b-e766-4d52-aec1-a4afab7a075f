/* global React, Icon, AgentPortrait, Badge, AOS_AGENTS */
/* Angeleck OS — Audio Call overlay.
   Parlez en direct avec Raphaël ; les autres agents restent en veille
   et peuvent être invités dans l'appel d'un tap. */
(function () {
  const h = React.createElement;

  function Waveform({ color, active }) {
    const bars = 30;
    return h('div', { style: { display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 4, height: 56 } },
      Array.from({ length: bars }).map((_, i) => {
        const mid = Math.abs(i - bars / 2) / (bars / 2);      // 0 center → 1 edges
        const base = 12 + (1 - mid) * 30;
        return h('span', { key: i, className: 'aos-wavebar', style: {
          height: base, background: color,
          animationDelay: (i * 0.045) + 's',
          animationDuration: (0.7 + (i % 5) * 0.12) + 's',
          opacity: active ? (0.45 + (1 - mid) * 0.55) : 0.18,
          animationPlayState: active ? 'running' : 'paused',
          boxShadow: active ? `0 0 8px ${color}` : 'none',
          transition: 'opacity .3s ease',
        } });
      }));
  }

  function CtrlButton({ icon, label, on = true, danger = false, onClick, rotate }) {
    const bg = danger ? 'var(--danger)' : on ? 'var(--glass-fill-strong)' : 'rgba(255,107,129,0.16)';
    const bd = danger ? 'var(--danger)' : on ? 'var(--border-soft)' : 'rgba(255,107,129,0.5)';
    const col = danger ? '#fff' : on ? 'var(--text-strong)' : 'var(--danger)';
    return h('div', { style: { display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 8 } },
      h('button', { onClick, title: label, style: {
        width: danger ? 64 : 54, height: 54, borderRadius: danger ? 999 : 16, cursor: 'pointer',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        background: bg, border: `1px solid ${bd}`, color: col,
        boxShadow: danger ? '0 8px 22px -6px rgba(255,107,129,0.6)' : 'var(--shadow-sm)',
        transition: 'transform var(--dur-fast), filter var(--dur-fast)' },
        onMouseEnter: e => { e.currentTarget.style.transform = 'translateY(-2px)'; e.currentTarget.style.filter = 'brightness(1.08)'; },
        onMouseLeave: e => { e.currentTarget.style.transform = 'none'; e.currentTarget.style.filter = 'none'; } },
        h(Icon, { name: icon, size: 21, color: col, style: rotate ? { transform: `rotate(${rotate}deg)` } : undefined })),
      h('span', { style: { fontFamily: 'var(--font-mono)', fontSize: 9, letterSpacing: '.06em', textTransform: 'uppercase', color: 'var(--text-faint)' } }, label));
  }

  function AudioCall({ agent, onClose }) {
    const all = AOS_AGENTS;
    const primary = (agent && all.find(a => a.id === agent.id)) || all.find(a => a.elite) || all[0];
    const [inCall, setInCall] = React.useState([primary.id]);
    const [secs, setSecs] = React.useState(0);
    const [mic, setMic] = React.useState(false);       // demarre coupe : on demande l'ecoute explicitement
    const [speaker, setSpeaker] = React.useState(true);
    const [listening, setListening] = React.useState(false);
    const [thinking, setThinking] = React.useState(false);
    const [ttsSpeaking, setTtsSpeaking] = React.useState(false);
    const [activeAgentId, setActiveAgentId] = React.useState(primary.id);
    const [transcript, setTranscript] = React.useState('');
    const [replyText, setReplyText] = React.useState('');
    const [voiceError, setVoiceError] = React.useState(null);
    const convRef = React.useRef(null);
    const recogRef = React.useRef(null);
    const micRef = React.useRef(mic);
    micRef.current = mic;

    const SpeechRecognitionCtor = typeof window !== 'undefined' && (window.SpeechRecognition || window.webkitSpeechRecognition);
    const supported = !!SpeechRecognitionCtor && typeof window !== 'undefined' && !!window.speechSynthesis;

    React.useEffect(() => { const iv = setInterval(() => setSecs(s => s + 1), 1000); return () => clearInterval(iv); }, []);
    React.useEffect(() => {
      const onKey = e => { if (e.key === 'Escape') onClose && onClose(); };
      window.addEventListener('keydown', onKey); return () => window.removeEventListener('keydown', onKey);
    }, [onClose]);

    function speak(text) {
      if (!supported || !speaker || !text) return;
      try {
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        u.lang = 'fr-FR';
        const voices = window.speechSynthesis.getVoices();
        const fr = voices.find(v => v.lang && v.lang.toLowerCase().startsWith('fr'));
        if (fr) u.voice = fr;
        u.onstart = () => setTtsSpeaking(true);
        u.onend = () => { setTtsSpeaking(false); if (micRef.current) startListening(); };
        u.onerror = () => { setTtsSpeaking(false); if (micRef.current) startListening(); };
        window.speechSynthesis.speak(u);
      } catch (e) { setTtsSpeaking(false); }
    }

    function sendToAngeleck(text) {
      const q = (text || '').trim();
      if (!q) { if (micRef.current) startListening(); return; }
      setTranscript(q);
      setThinking(true);
      fetch('/api/chat', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: q, conversation_id: convRef.current }),
      }).then(r => r.json()).then(d => {
        setThinking(false);
        if (d && d.conversation_id) convRef.current = d.conversation_id;
        const usedId = (d && d.agents_used && d.agents_used[0]) || primary.id;
        const found = all.find(a => a.id === usedId);
        setActiveAgentId(found ? found.id : primary.id);
        setInCall(c => (found && !c.includes(found.id)) ? [...c, found.id] : c);
        const clean = (d && d.answer ? d.answer : '').replace(/[#*`_>]/g, '').replace(/\s+/g, ' ').trim();
        setReplyText(clean);
        speak(clean);
      }).catch(() => {
        setThinking(false);
        setVoiceError("Impossible de joindre le cerveau Angeleck.");
        if (micRef.current) startListening();
      });
    }

    function startListening() {
      if (!supported) { setVoiceError("Reconnaissance vocale non supportee par ce navigateur (utilisez Chrome ou Edge)."); return; }
      if (recogRef.current) { try { recogRef.current.abort(); } catch (e) {} }
      const r = new SpeechRecognitionCtor();
      r.lang = 'fr-FR'; r.continuous = false; r.interimResults = false; r.maxAlternatives = 1;
      r.onstart = () => { setListening(true); setVoiceError(null); };
      r.onresult = (ev) => {
        const text = ev.results[0][0].transcript;
        setListening(false);
        sendToAngeleck(text);
      };
      r.onerror = (ev) => {
        setListening(false);
        if (ev.error === 'not-allowed' || ev.error === 'service-not-allowed') {
          setVoiceError("Acces au microphone refuse — autorisez-le dans les parametres du navigateur.");
          setMic(false);
        } else if (ev.error !== 'no-speech' && ev.error !== 'aborted') {
          setVoiceError("Erreur de reconnaissance vocale : " + ev.error);
        }
      };
      r.onend = () => {
        setListening(false);
        // Boucle d'ecoute continue tant que le micro est actif et qu'on n'est pas en train de repondre/parler.
        if (micRef.current) setTimeout(() => { if (micRef.current && !ttsSpeaking) startListening(); }, 400);
      };
      recogRef.current = r;
      try { r.start(); } catch (e) {}
    }

    function stopListening() {
      if (recogRef.current) { try { recogRef.current.abort(); } catch (e) {} }
      setListening(false);
    }

    function toggleMic() {
      setMic(m => {
        const next = !m;
        if (next) startListening(); else stopListening();
        return next;
      });
    }

    function toggleSpeaker() {
      setSpeaker(s => {
        if (s) window.speechSynthesis && window.speechSynthesis.cancel();
        return !s;
      });
    }

    function hangUp() {
      stopListening();
      if (typeof window !== 'undefined' && window.speechSynthesis) window.speechSynthesis.cancel();
      onClose && onClose();
    }

    const speaker_ = all.find(a => a.id === activeAgentId) || primary;
    const mmss = `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}`;
    const toggle = id => setInCall(c => c.includes(id) ? (id === primary.id ? c : c.filter(x => x !== id)) : [...c, id]);
    const displayStatus = thinking ? 'thinking' : (ttsSpeaking || listening) ? 'active' : 'idle';
    const captionText = thinking ? 'Raphael reflechit…' : ttsSpeaking ? replyText : listening ? (transcript ? '« ' + transcript + ' »' : 'Je vous ecoute…') : voiceError ? voiceError : 'Micro coupe — appuyez sur Micro pour parler.';

    return h('div', { className: 'aos-overlay', onClick: e => { if (e.target === e.currentTarget) onClose && onClose(); } },
      h('div', { style: {
        width: 'min(560px, 92vw)', padding: '30px 30px 26px', borderRadius: 'var(--r-xl, 24px)', textAlign: 'center',
        background: 'var(--glass-fill-strong)', backdropFilter: 'blur(var(--blur-lg))', WebkitBackdropFilter: 'blur(var(--blur-lg))',
        border: '1px solid var(--border-soft)', boxShadow: 'var(--sheen-card), var(--shadow-xl), var(--glow-diamond)',
        animation: 'aos-pop-in var(--dur-slow) var(--ease-out)' } },

        /* header */
        h('div', { style: { display: 'flex', alignItems: 'center', justifyContent: 'space-between' } },
          h('span', { style: { display: 'inline-flex', alignItems: 'center', gap: 8, fontFamily: 'var(--font-mono)', fontSize: 10, letterSpacing: '.14em', textTransform: 'uppercase', color: 'var(--diamond-400)' } },
            h('span', { style: { width: 7, height: 7, borderRadius: '50%', background: 'var(--success)', boxShadow: '0 0 8px var(--success)', animation: 'aos-blink 1.6s infinite' } }),
            'Appel audio · réel'),
          h('span', { style: { fontFamily: 'var(--font-mono)', fontSize: 13, color: 'var(--text-body)' } }, mmss),
          h('button', { onClick: hangUp, title: 'Fermer', style: { width: 34, height: 34, borderRadius: 10, display: 'flex', alignItems: 'center', justifyContent: 'center', background: 'var(--glass-fill)', border: '1px solid var(--border-soft)', color: 'var(--text-muted)', cursor: 'pointer' } },
            h(Icon, { name: 'close', size: 16 }))),

        !supported && h('div', { style: { marginTop: 14, padding: '10px 12px', borderRadius: 'var(--r-md)', background: 'color-mix(in srgb, var(--danger) 12%, transparent)', border: '1px solid rgba(255,107,129,0.4)', fontSize: 11.5, color: 'var(--danger)', textAlign: 'left' } },
          "Reconnaissance et synthese vocales non disponibles dans ce navigateur. Utilisez Google Chrome ou Microsoft Edge pour parler a voix haute avec Raphael."),

        /* speaking agent */
        h('div', { style: { marginTop: 22, display: 'flex', flexDirection: 'column', alignItems: 'center' } },
          h('div', { style: { position: 'relative', display: 'inline-flex' } },
            (ttsSpeaking || listening) && [0, 1].map(k => h('span', { key: k, style: { position: 'absolute', inset: 0, borderRadius: '50%', border: `2px solid ${speaker_.color}`, animation: `aos-ring-out 2.4s var(--ease-out) ${k * 1.2}s infinite` } })),
            h(AgentPortrait, { cfg: speaker_.portrait, color: speaker_.color, status: displayStatus, size: 132 })),
          h('div', { style: { fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: 24, color: 'var(--text-strong)', marginTop: 18 } }, speaker_.name),
          h('div', { style: { fontFamily: 'var(--font-mono)', fontSize: 11, letterSpacing: '.1em', textTransform: 'uppercase', color: speaker_.color, marginTop: 4 } }, speaker_.role),
          h('div', { style: { marginTop: 8, fontSize: 12.5, color: 'var(--text-muted)', maxWidth: 440, minHeight: 18, lineHeight: 1.5 } }, captionText)),

        /* waveform */
        h('div', { style: { marginTop: 16 } }, h(Waveform, { color: speaker_.color, active: ttsSpeaking || listening })),

        /* participants */
        h('div', { style: { marginTop: 14, paddingTop: 16, borderTop: '1px solid var(--border-hairline)' } },
          h('div', { style: { fontFamily: 'var(--font-mono)', fontSize: 9, letterSpacing: '.14em', textTransform: 'uppercase', color: 'var(--text-faint)', marginBottom: 6, textAlign: 'left' } },
            `Dans l'appel · ${inCall.length}`),
          h('div', { style: { fontSize: 10.5, color: 'var(--text-faint)', marginBottom: 10, textAlign: 'left' } }, 'Raphaël sélectionne automatiquement le meilleur expert pour répondre.'),
          h('div', { className: 'aos-scroll', style: { display: 'flex', gap: 14, overflowX: 'auto', paddingBottom: 6 } },
            all.map(a => {
              const on = inCall.includes(a.id);
              const isSpk = on && a.id === activeAgentId && (ttsSpeaking || thinking);
              return h('span', { key: a.id, title: a.name, style: {
                position: 'relative', flexShrink: 0, width: 60, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 6,
                opacity: on ? 1 : 0.4, transition: 'opacity var(--dur-fast)' } },
                h('span', { style: { position: 'relative' } },
                  h(AgentPortrait, { cfg: a.portrait, color: a.color, status: isSpk ? (thinking ? 'thinking' : 'active') : 'idle', size: 44, ring: on }),
                  on && a.id !== primary.id && h('span', { style: { position: 'absolute', right: -2, bottom: -2, width: 16, height: 16, borderRadius: '50%', background: 'var(--success)', border: '2px solid var(--surface-card)' } })),
                h('span', { style: { fontSize: 10.5, fontWeight: 600, color: on ? 'var(--text-body)' : 'var(--text-faint)', whiteSpace: 'nowrap' } }, a.name)); }))),

        /* controls */
        h('div', { style: { marginTop: 20, display: 'flex', alignItems: 'flex-start', justifyContent: 'center', gap: 22 } },
          h(CtrlButton, { icon: mic ? 'mic' : 'micOff', label: mic ? (listening ? 'Écoute…' : 'Micro') : 'Coupé', on: mic, onClick: toggleMic }),
          h(CtrlButton, { icon: speaker ? 'volume' : 'micOff', label: speaker ? 'Son' : 'Muet', on: speaker, onClick: toggleSpeaker }),
          h(CtrlButton, { icon: 'phone', label: 'Raccrocher', danger: true, rotate: 135, onClick: hangUp }))));
  }

  window.AudioCall = AudioCall;
})();
