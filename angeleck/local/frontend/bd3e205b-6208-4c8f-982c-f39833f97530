            style: { width: 28, height: 28, borderRadius: '50%', cursor: 'pointer', background: c, border: on ? '2px solid #fff' : '2px solid transparent', boxShadow: on ? `0 0 0 2px ${c}, 0 0 14px ${c}` : `0 0 8px -2px ${c}`, transition: 'all var(--dur-fast)' } }); }))),

      /* appearance */
      React.createElement('div', null,
        React.createElement(SectionLabel, null, 'Apparence'),
        /* skin */
        React.createElement('div', { style: { display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 12 } },
          React.createElement('span', { style: { fontSize: 12, color: 'var(--text-muted)' } }, 'Teint'),
          React.createElement('div', { style: { display: 'flex', gap: 7 } },
            GN_SKINS.map(s => { const on = cfg.skin === s; return React.createElement('button', { key: s, onClick: () => set('skin', s), disabled: phase === 'gen', title: s,
              style: { width: 22, height: 22, borderRadius: '50%', cursor: 'pointer', background: gnSkinSwatch(s), border: on ? '2px solid var(--diamond-400)' : '1px solid var(--border-soft)' } }); }))),
        /* hair style + colour */
        React.createElement('div', { style: { display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 12, gap: 10 } },
          React.createElement('span', { style: { fontSize: 12, color: 'var(--text-muted)' } }, 'Cheveux'),
          React.createElement('div', { style: { display: 'flex', alignItems: 'center', gap: 8 } },
            React.createElement('button', { onClick: () => cycle('hair', GN_HAIRS), disabled: phase === 'gen',
              style: { height: 30, padding: '0 12px', borderRadius: 999, cursor: 'pointer', background: 'var(--glass-fill)', border: '1px solid var(--border-soft)', color: 'var(--text-body)', fontFamily: 'var(--font-mono)', fontSize: 11, textTransform: 'capitalize' } }, cfg.hair),
            React.createElement('div', { style: { display: 'flex', gap: 5 } },
              GN_HAIRCOLORS.map(hc => { const on = cfg.hairColor === hc; return React.createElement('button', { key: hc, onClick: () => set('hairColor', hc), disabled: phase === 'gen',
                style: { width: 18, height: 18, borderRadius: '50%', cursor: 'pointer', background: hc, border: on ? '2px solid var(--diamond-400)' : '1px solid var(--border-hairline)' } }); })))),
        /* accessory toggles */
        React.createElement('div', { style: { display: 'flex', flexWrap: 'wrap', gap: 8, marginTop: 4 } },
          [['glasses', cfg.glasses ? false : 'thin', 'Lunettes'], ['beard', cfg.beard ? false : 'stubble', 'Barbe'], ['headset', !cfg.headset, 'Casque'], ['smile', !cfg.smile, 'Sourire']].map(([k, v, lbl]) => {
            const on = !!cfg[k]; return React.createElement('button', { key: k, onClick: () => set(k, v), disabled: phase === 'gen',
              style: { padding: '7px 13px', borderRadius: 999, cursor: 'pointer', fontFamily: 'var(--font-sans)', fontSize: 12, fontWeight: 600,
                background: on ? 'var(--info-soft)' : 'var(--glass-fill)', border: `1px solid ${on ? 'var(--border-accent)' : 'var(--border-hairline)'}`, color: on ? 'var(--diamond-400)' : 'var(--text-muted)' } }, lbl); }))),

      /* personality */
      React.createElement('div', null,
        React.createElement(SectionLabel, null, 'Personnalité · ' + traits.length + '/3'),
        React.createElement('div', { style: { display: 'flex', flexWrap: 'wrap', gap: 8 } },
          GN_TRAITS.map(t => { const on = traits.includes(t); return React.createElement('button', { key: t, onClick: () => toggleTrait(t), disabled: phase === 'gen' || (!on && traits.length >= 3),
            style: { padding: '7px 13px', borderRadius: 999, cursor: 'pointer', fontFamily: 'var(--font-sans)', fontSize: 12, fontWeight: 600, opacity: (!on && traits.length >= 3) ? 0.4 : 1,
              background: on ? `color-mix(in srgb, ${color} 16%, transparent)` : 'var(--glass-fill)', border: `1px solid ${on ? `color-mix(in srgb, ${color} 50%, transparent)` : 'var(--border-hairline)'}`, color: on ? color : 'var(--text-muted)' } }, t); })))
    )
  );
}

function gnSkinSwatch(s) {
  return { porcelain: '#F4D0B0', light: '#EFC09A', tan: '#D9A578', warm: '#C68A5E', deep: '#9A6440', espresso: '#774B30' }[s] || '#EFC09A';
}
