    isUser ? React.createElement(Avatar, { name: 'Vous', color: 'var(--sapphire-500)', size: 34 }) : React.createElement(Avatar, { name: 'Raphaël', color: raphael.color, elite: true, size: 34 }),
    React.createElement('div', { style: { maxWidth: '78%', display: 'flex', flexDirection: 'column', alignItems: isUser ? 'flex-end' : 'flex-start' } },
      React.createElement('div', { style: { padding: '12px 16px', borderRadius: isUser ? '16px 16px 4px 16px' : '16px 16px 16px 4px', background: isUser ? 'rgba(46,123,224,0.20)' : 'var(--glass-fill-strong)', border: `1px solid ${isUser ? 'var(--border-accent)' : 'var(--border-soft)'}`, color: 'var(--text-body)', fontSize: 14, lineHeight: 1.65 }, dangerouslySetInnerHTML: { __html: m.content } }),
      React.createElement('div', { style: { display: 'flex', alignItems: 'center', gap: 8, marginTop: 5, padding: '0 4px' } },
