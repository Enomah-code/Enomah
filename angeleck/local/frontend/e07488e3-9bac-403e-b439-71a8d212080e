  function pickAgents(text) {
    const low = text.toLowerCase();
    const map = { sofia: ['business', 'boutique', 'stratég', 'saas', 'lancer', 'marché'], maya: ['marketing', 'campagne', 'ads', 'acquisition', 'pub'], nathan: ['copy', 'texte', 'rédige', 'identité', 'slogan'], elena: ['design', 'visuel', 'identité', 'marque', 'logo'], lucas: ['boutique', 'shopify', 'e-commerce', 'vente'], emma: ['data', 'analyse', 'forecast', 'portefeuille', 'rapport'], adam: ['finance', 'portefeuille', 'trading', 'investir', 'crypto'], gabriel: ['tech', 'automatis', 'intégr', 'site'], noah: ['vidéo', 'média', 'contenu'], lea: ['sécurité', 'risque', 'conformité', 'rgpd'] };
    let hits = Object.keys(map).filter(id => map[id].some(k => low.includes(k)));
    if (!hits.length) hits = ['sofia', 'emma'];
    return hits.slice(0, 4);
  }

  function send(text) {
    const q = (text || input).trim();
    if (!q || proc) return;
    setInput('');
    setMessages(m => [...m, { role: 'user', content: q, time: now() }]);
    const ids = pickAgents(q);
    setProc({ step: 'analyse', agents: ids.map(id => ({ id, pct: 0 })) });
    setTimeout(() => setProc(p => p && ({ ...p, step: 'delegate' })), 700);

    // Appel reel au cerveau central Angeleck (backend FastAPI).
    // L'animation de travail tourne tant que la reponse n'est pas arrivee.
    let done = false, apiData = null;
    fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: q, conversation_id: convRef.current }),
    }).then(r => r.ok ? r.json() : null)
      .then(d => { apiData = d; done = true; })
      .catch(() => { done = true; });

    const iv = setInterval(() => {
      setProc(p => { if (!p) return p; return { ...p, step: 'work', agents: p.agents.map(a => ({ ...a, pct: done ? 100 : Math.min(96, a.pct + 6 + Math.random() * 8) })) }; });
      if (done) {
        clearInterval(iv);
        setProc(p => p && ({ ...p, step: 'synth' }));
        setTimeout(() => {
          setProc(null);
          if (apiData && apiData.answer) {
            if (apiData.conversation_id) convRef.current = apiData.conversation_id;
            const real = (apiData.agents_used || []).filter(id => byId[id]);
            setMessages(m => [...m, { role: 'assistant', content: aosMdToHtml(apiData.answer), agents: real.length ? real : ids, time: now() }]);
          } else {
            // Backend indisponible : reponse de secours simulee.
            setMessages(m => [...m, { role: 'assistant', content: answerFor(q, ids), agents: ids, time: now() }]);
