/* global React, Icon, Avatar, Badge, Button, GlassCard, Eyebrow, SectionLabel, AOS_AGENTS */
/* Markdown leger -> HTML sur (echappe d'abord le HTML par securite). */
function aosMdToHtml(md) {
  let s = String(md || '');
  s = s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  s = s.replace(/^######\s+(.+)$/gm, '<strong>$1</strong>')
       .replace(/^#####\s+(.+)$/gm, '<strong>$1</strong>')
       .replace(/^####\s+(.+)$/gm, '<strong>$1</strong>')
       .replace(/^###\s+(.+)$/gm, '<strong style="font-size:15px">$1</strong>')
       .replace(/^##\s+(.+)$/gm, '<strong style="font-size:16px">$1</strong>')
       .replace(/^#\s+(.+)$/gm, '<strong style="font-size:17px">$1</strong>');
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
  s = s.replace(/`([^`]+)`/g, '<code style="background:rgba(255,255,255,0.08);padding:1px 5px;border-radius:4px;font-family:var(--font-mono);font-size:12.5px">$1</code>');
  s = s.replace(/^&gt;\s?(.*)$/gm, '<span style="display:block;border-left:2px solid var(--border-accent);padding-left:10px;opacity:.9">$1</span>');
  s = s.replace(/^\s*[-•]\s+(.+)$/gm, '<span style="display:block;padding-left:14px">&bull; $1</span>');
  s = s.replace(/^---+$/gm, '<hr style="border:none;border-top:1px solid var(--border-soft);margin:8px 0">');
  s = s.replace(/\n\n/g, '<br><br>').replace(/\n/g, '<br>');
  return s;
}

