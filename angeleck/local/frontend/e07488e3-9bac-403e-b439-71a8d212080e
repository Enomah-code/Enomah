  return React.createElement('div', { style: { display: 'flex', width: '100%', height: '100%' } },
    /* center thread */
    React.createElement('div', { style: { flex: 1, display: 'flex', flexDirection: 'column', minWidth: 0 } },
      React.createElement('div', { ref: threadRef, className: 'aos-scroll', style: { flex: 1, padding: '26px 30px', display: 'flex', flexDirection: 'column', gap: 16 } },
        messages.length === 0 && !proc && React.createElement('div', { style: { margin: 'auto', textAlign: 'center', maxWidth: 540 } },
          React.createElement('div', { style: { display: 'inline-flex' } }, React.createElement(Avatar, { name: 'Raphaël', color: raphael.color, elite: true, status: 'active', size: 76 })),
          React.createElement('h1', { style: { fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: 26, color: 'var(--text-strong)', margin: '20px 0 8px' } }, 'Bonjour, je suis Raphaël.'),
          React.createElement('p', { style: { color: 'var(--text-muted)', fontSize: 14, margin: '0 0 24px' } }, 'Confiez-moi un objectif. Je mobilise les bons experts, coordonne le travail et vous livre un résultat actionnable.'),
          React.createElement('div', { style: { display: 'flex', flexWrap: 'wrap', gap: 10, justifyContent: 'center' } },
            suggestions.map((s, i) => React.createElement('button', { key: i, onClick: () => send(s.t), style: { padding: '10px 16px', borderRadius: '999px', border: '1px solid var(--border-soft)', background: 'var(--glass-fill)', color: 'var(--text-body)', fontSize: 13, cursor: 'pointer', fontFamily: 'var(--font-sans)' } }, s.t)))),

        messages.map((m, i) => React.createElement(MessageRow, { key: i, m, raphael, byId })),

        proc && React.createElement(Pipeline, { proc, byId })
      ),

      /* composer */
      React.createElement('div', { style: { padding: '14px 30px 22px', borderTop: '1px solid var(--border-hairline)' } },
        React.createElement('div', { style: { display: 'flex', gap: 12, alignItems: 'flex-end', background: 'var(--glass-fill)', backdropFilter: 'blur(var(--blur-sm))', border: '1px solid var(--border-soft)', borderRadius: 'var(--r-lg)', padding: '12px 14px' } },
          React.createElement('button', { onClick: () => onCall && onCall(raphael), title: 'Appel audio avec Raphaël', style: { width: 40, height: 40, flexShrink: 0, borderRadius: 'var(--r-md)', display: 'flex', alignItems: 'center', justifyContent: 'center', background: 'var(--glass-fill-strong)', border: '1px solid var(--border-soft)', color: 'var(--diamond-400)', cursor: 'pointer' } }, React.createElement(Icon, { name: 'phone', size: 18, color: 'var(--diamond-400)' })),
          React.createElement('textarea', { value: input, onChange: e => setInput(e.target.value), rows: 1, placeholder: 'Confiez un objectif à Raphaël…', onKeyDown: e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); } }, style: { flex: 1, background: 'transparent', border: 'none', outline: 'none', resize: 'none', color: 'var(--text-strong)', fontFamily: 'var(--font-sans)', fontSize: 14, lineHeight: 1.5, maxHeight: 100 } }),
          React.createElement(Button, { variant: 'primary', size: 'md', disabled: !input.trim() || !!proc, onClick: () => send(), style: { width: 44, padding: 0 } }, React.createElement(Icon, { name: 'send', size: 17, color: '#fff' }))),
        React.createElement('div', { style: { fontFamily: 'var(--font-mono)', fontSize: 9, color: 'var(--text-faint)', marginTop: 8, textAlign: 'center' } }, 'Raphaël mobilise automatiquement les agents pertinents · Entrée pour envoyer'))
    )
  );
}

