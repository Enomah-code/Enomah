function Pipeline({ proc, byId }) {
  const steps = [['analyse', 'Analyse de la demande'], ['delegate', 'Délégation aux experts'], ['work', 'Traitement en cours'], ['synth', 'Synthèse']];
  const curIdx = steps.findIndex(s => s[0] === proc.step);
