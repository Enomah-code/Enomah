    React.createElement(Avatar, { name: 'Raphaël', color: '#E7CD93', elite: true, status: 'thinking', size: 34 }),
    React.createElement(GlassCard, { accent: true, padding: 16, style: { maxWidth: 460, flex: 1 } },
      React.createElement('div', { style: { display: 'flex', alignItems: 'center', gap: 8, marginBottom: 12 } },
        React.createElement('span', { className: 'aos-typing' }, React.createElement('span'), React.createElement('span'), React.createElement('span')),
        React.createElement('span', { style: { fontSize: 12, color: 'var(--text-muted)' } }, steps[curIdx] ? steps[curIdx][1] : '…')),
      React.createElement('div', { style: { display: 'flex', flexDirection: 'column', gap: 10 } },
        proc.agents.map(a => { const ag = byId[a.id]; return React.createElement('div', { key: a.id, style: { display: 'flex', alignItems: 'center', gap: 10 } },
          React.createElement(Avatar, { name: ag.name, color: ag.color, status: a.pct >= 100 ? 'idle' : 'active', size: 24 }),
          React.createElement('span', { style: { fontSize: 12, fontWeight: 600, color: 'var(--text-body)', width: 64, flexShrink: 0 } }, ag.name),
          React.createElement('div', { style: { flex: 1, height: 4, borderRadius: 4, background: 'rgba(255,255,255,0.06)', overflow: 'hidden' } },
            React.createElement('div', { style: { height: '100%', width: a.pct + '%', borderRadius: 4, background: ag.color, transition: 'width .3s var(--ease-out)' } })),
          a.pct >= 100 ? React.createElement(Icon, { name: 'check', size: 14, color: ag.color }) : React.createElement('span', { style: { fontFamily: 'var(--font-mono)', fontSize: 10, color: 'var(--text-faint)', width: 28, textAlign: 'right' } }, Math.round(a.pct) + '%')); }))));
}

function now() { return new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }); }
function answerFor(q, ids) {
  const names = ids.map(id => AOS_AGENTS.find(a => a.id === id).name);
  return `<strong style="color:var(--text-strong)">Mission coordonnée.</strong> J'ai mobilisé ${names.join(', ')} pour traiter votre demande.<br/><br/>` +
    `<div style="font-weight:600;color:var(--text-strong);margin-bottom:4px">Plan d'action</div>` +
    `<div style="padding-left:2px;color:var(--text-muted)">• Cadrage de l'objectif et des contraintes<br/>• Production par chaque expert de son livrable<br/>• Synthèse priorisée et prochaines étapes</div><br/>` +
    `Souhaitez-vous que je lance l'exécution détaillée, ou que j'affine une partie du plan&nbsp;?`;
}
window.Conversation = Conversation;
